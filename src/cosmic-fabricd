#!/usr/bin/env python3
"""cosmic-fabricd — the cosmic-fabric backbone.

Owns one fabric deployment: ensures `fabric --serve` is up, holds the policy,
runs patterns over REST, checks GPU placement, and serves a unix-socket JSON API
that thin clients (the launcher now; panel/settings later) call.

Protocol: line-delimited JSON, one request → one response per line (json escapes
newlines, so bodies stay single-line). Ops:
  {"op":"ping"}                                  -> {"ok":true,"serve":bool}
  {"op":"patterns"}                              -> {"patterns":[...]}
  {"op":"run","pattern":P,"input":T,             -> {"output":...,"model":...,
        "model"?:M,"vendor"?:V,"variables"?:{}}        "vendor":...,"placement":pct,"warn_below":n}
                                                    or {"error":"..."}
"""
import json
import os
import queue
import socket
import socketserver
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import core  # noqa: E402

LOG = os.path.expanduser("~/.cache/cosmic-fabric/daemon.log")
_pat_cache = None
_lock = threading.Lock()
FAB = None

# Result broker: subscribers (e.g. the panel) register a queue; a run with
# "broadcast":true (e.g. from the launcher) pushes its events to all of them.
SUBS = []
SUBS_LOCK = threading.Lock()


def broadcast(event):
    with SUBS_LOCK:
        subs = list(SUBS)
    for q in subs:
        try:
            q.put_nowait(event)
        except Exception:
            pass


def notify_user(text, pattern):
    """Clipboard + desktop notification for a completed broadcast run. Lives in
    the daemon (one process) so the alert fires exactly once, regardless of how
    many panel clients are subscribed."""
    try:
        subprocess.run(["wl-copy"], input=text, text=True, timeout=5)
    except Exception as e:
        log(f"wl-copy: {e}")
    preview = text[:200]
    body = f"✓ copied ({len(text)} chars) · open the Fabric panel\n\n{preview}"
    try:
        subprocess.run(["notify-send", f"Fabric: {pattern}", body], timeout=5,
                       stdin=subprocess.DEVNULL)
    except Exception as e:
        log(f"notify-send: {e}")


def log(msg):
    line = f"{time.strftime('%H:%M:%S')} [{os.getpid()}] {msg}"
    print(line, file=sys.stderr, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except Exception:
        pass


def sock_path():
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        base = os.path.expanduser("~/.cache/cosmic-fabric")
        os.makedirs(base, exist_ok=True)
    return os.path.join(base, "cosmic-fabric.sock")


def handle(req):
    op = req.get("op")
    if op == "ping":
        return {"ok": True, "serve": FAB.alive()}
    if op == "fabric_url":
        # The live fabric REST base URL (loopback). Escape hatch for tools that
        # want raw fabric — most callers should use the ops above instead.
        return {"url": FAB.url}
    if op == "patterns":
        global _pat_cache
        with _lock:
            if _pat_cache is None:
                _pat_cache = FAB.list_patterns()
        return {"patterns": _pat_cache}
    if op == "models":
        return {"models": FAB.list_models(), "vendors": FAB.model_catalog()}
    if op == "assemble":
        pat = req.get("pattern")
        if not pat:
            return {"error": "missing pattern"}
        pol = core.load_policy()
        try:
            prompt = FAB.assemble_prompt(pat, req.get("input", ""), req.get("variables"))
        except Exception as e:
            log(f"assemble error: {e}")
            return {"error": str(e)}
        log(f"assemble pattern={pat} → {len(prompt)} chars")
        return {"prompt": prompt}
    if op == "surface":
        pol = core.load_policy()
        return {"active": core.active_patterns(pol, FAB.list_patterns())}
    if op == "fetch":
        url = req.get("url")
        if not url:
            return {"error": "missing url"}
        mode = req.get("mode", "scrape")
        try:
            text = core.fetch_url(url, mode)
        except Exception as e:
            log(f"fetch error: {e}")
            return {"error": str(e)}
        log(f"fetch {mode} {url} -> {len(text)} chars")
        return {"text": text, "chars": len(text)}
    if op == "status":
        pol = core.load_policy()
        dinst = core.resolve("", pol)  # "" ∉ patterns → resolves the default
        return {"serve": FAB.alive(),
                "loaded": core.loaded_models(pol["ollama"]["url"]),
                "vram": core.gpu_vram(),
                "default_model": dinst.get("model"),
                "default_vendor": dinst.get("vendor")}
    if op == "run":
        pat = req.get("pattern")
        image = req.get("image")
        if not pat and not image:
            return {"error": "missing pattern"}  # a text run needs a pattern; image runs don't
        pol = core.load_policy()  # re-read live so policy edits take effect
        inp = req.get("input", "")
        # An image run needs a vision model — the capability rule swaps one in.
        inst = core.resolve(pat, pol, need_capability="vision" if image else None)
        model = req.get("model") or inst["model"]
        vendor = req.get("vendor") or inst["vendor"]
        if image:
            log(f"run image={image} pattern={pat} model={model} vendor={vendor} (vision rule)")
            try:
                out = FAB.run_image(image, inp, model, vendor, pattern=pat or None)
            except Exception as e:
                log(f"run-image error: {e}")
                return {"error": str(e)}
            pct = core.gpu_placement(model, pol["ollama"]["url"]) if (vendor or "").lower() == "ollama" else None
            return {"output": out, "model": model, "vendor": vendor, "placement": pct,
                    "warn_below": pol["ollama"].get("warn_below_gpu", 99), "capability": "vision"}
        opts = core.inst_to_options(inst)
        is_ollama = (vendor or "").lower() == "ollama"
        mctx = inst.get("ctx") or (core.pick_ctx(inp) if is_ollama else None)
        log(f"run pattern={pat} model={model} vendor={vendor} input={len(inp)}ch ctx={mctx} opts={opts}")
        try:
            out = FAB.run(pat, inp, model, vendor, req.get("variables"), opts, model_ctx=mctx)
        except Exception as e:
            log(f"run error: {e}")
            return {"error": str(e)}
        pct = core.gpu_placement(model, pol["ollama"]["url"]) if (vendor or "").lower() == "ollama" else None
        log(f"run done: {len(out)}ch placement={pct}")
        return {"output": out, "model": model, "vendor": vendor,
                "placement": pct, "warn_below": pol["ollama"].get("warn_below_gpu", 99)}
    return {"error": f"unknown op {op!r}"}


def stream_run(req, send):
    """`{"op":"run","stream":true}` → {"chunk":...} lines then {"done":...}.

    With `"broadcast":true` the run's events are pushed to all subscribers
    (the panel) as {"event":"start|chunk|done", ...} instead, and the
    requester (the launcher) just gets {"dispatched":true} — this is the
    launcher→panel handoff."""
    pat = req.get("pattern")
    session = req.get("session")
    if not pat and not session:
        send({"error": "missing pattern"})  # a bare run needs a pattern; chat needs a session
        return
    bcast = bool(req.get("broadcast"))
    if bcast:
        with SUBS_LOCK:
            nsubs = len(SUBS)
        if nsubs == 0:
            # No panel subscribed — don't run into the void; let the caller
            # (launcher) fall back to local delivery.
            send({"dispatched": False, "subscribers": 0})
            return
    if session and not pat:
        pat = "raw_query"  # fabric's universal relay — chat without a transforming pattern
    pol = core.load_policy()
    inst = core.resolve(pat or "", pol)  # chat → the default instantiation
    model = req.get("model") or inst["model"]
    vendor = req.get("vendor") or inst["vendor"]
    opts = core.inst_to_options(inst)
    warn_below = pol["ollama"].get("warn_below_gpu", 99)
    log(f"run-stream pattern={pat} session={session} model={model} vendor={vendor} broadcast={bcast}")
    if bcast:
        broadcast({"event": "start", "pattern": pat, "model": model})
        send({"dispatched": True, "subscribers": nsubs})  # quick ack; the panel shows it

    def on_chunk(c):
        if bcast:
            broadcast({"event": "chunk", "text": c})
        else:
            send({"chunk": c})

    inp = req.get("input", "")
    mctx = inst.get("ctx") or (core.pick_ctx(inp) if (vendor or "").lower() == "ollama" else None)
    try:
        out = FAB.run(pat, inp, model, vendor, req.get("variables"), opts,
                      on_chunk=on_chunk, model_ctx=mctx, session=session)
    except Exception as e:
        log(f"run-stream error: {e}")
        (broadcast if bcast else send)({"event": "error", "error": str(e)} if bcast else {"error": str(e)})
        return
    pct = core.gpu_placement(model, pol["ollama"]["url"]) if (vendor or "").lower() == "ollama" else None
    log(f"run-stream done: placement={pct} broadcast={bcast}")
    done = {"model": model, "vendor": vendor, "placement": pct, "warn_below": warn_below}
    if bcast:
        broadcast({"event": "done", **done})
        notify_user(out, pat)  # one alert, from the daemon (not per-panel)
    else:
        send({"done": True, **done})


def run_subscribe(send, rfile):
    """Dedicate this connection to receiving broadcast events (the panel).
    A watcher thread reads the (otherwise-silent) socket to detect disconnect
    promptly, so stale subscribers don't linger until the next failed send."""
    q = queue.Queue(maxsize=512)
    stop = object()
    with SUBS_LOCK:
        SUBS.append(q)
    log(f"subscriber added ({len(SUBS)} total)")

    def watch_disconnect():
        try:
            while rfile.read(1):  # subscriber sends nothing; read blocks until EOF
                pass
        except Exception:
            pass
        q.put(stop)
    threading.Thread(target=watch_disconnect, daemon=True).start()

    try:
        send({"subscribed": True})
        while True:
            ev = q.get()
            if ev is stop:
                break
            send(ev)
    except Exception:
        pass
    finally:
        with SUBS_LOCK:
            if q in SUBS:
                SUBS.remove(q)
        log(f"subscriber removed ({len(SUBS)} left)")


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        def send(obj):
            self.wfile.write((json.dumps(obj) + "\n").encode())
            self.wfile.flush()

        for raw in self.rfile:
            raw = raw.strip()
            if not raw:
                continue
            try:
                req = json.loads(raw)
            except Exception:
                send({"error": "bad json"})
                continue
            if req.get("op") == "subscribe":
                run_subscribe(send, self.rfile)
                return  # connection dedicated to pushing broadcasts
            if req.get("op") == "run" and (req.get("stream") or req.get("broadcast")):
                stream_run(req, send)
            else:
                send(handle(req))


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    global FAB
    path = sock_path()
    # Don't steal the socket from a live daemon — that orphans it (and its
    # subscribers). If one already answers, exit; only take over a stale socket.
    if os.path.exists(path):
        try:
            t = socket.socket(socket.AF_UNIX)
            t.settimeout(1)
            t.connect(path)
            t.sendall(b'{"op":"ping"}\n')
            t.recv(64)
            t.close()
            log("another cosmic-fabricd is already listening; exiting")
            return
        except OSError:
            pass  # stale socket, no live daemon → safe to take over
    FAB = core.FabricClient(log=log)
    FAB.ensure_serve()
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    except OSError as e:
        log(f"could not remove stale socket: {e}")
    srv = Server(path, Handler)
    log(f"listening on {path}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
