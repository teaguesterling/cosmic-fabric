#!/usr/bin/env python3
"""cosmic-fabricd — the cosmic-fabric backbone.

Owns one fabric deployment: ensures `fabric --serve` is up, holds the policy,
runs patterns over REST, checks GPU placement, and serves a unix-socket JSON API
that thin clients (the launcher now; panel/settings later) call.

Protocol: line-delimited JSON, one request → one response per line (json escapes
newlines, so bodies stay single-line). Ops:
  {"op":"ping"}                                  -> {"ok":true,"serve":bool}
  {"op":"patterns"}                              -> {"patterns":[...]}
  {"op":"run","pattern":P,"input":T,             -> {"output":...,"model":...,
        "model"?:M,"vendor"?:V,"variables"?:{}}        "vendor":...,"placement":pct,"warn_below":n}
                                                    or {"error":"..."}
"""
import json
import os
import queue
import socketserver
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import core  # noqa: E402

LOG = os.path.expanduser("~/.cache/cosmic-fabric/daemon.log")
_pat_cache = None
_lock = threading.Lock()
FAB = None

# Result broker: subscribers (e.g. the panel) register a queue; a run with
# "broadcast":true (e.g. from the launcher) pushes its events to all of them.
SUBS = []
SUBS_LOCK = threading.Lock()


def broadcast(event):
    with SUBS_LOCK:
        subs = list(SUBS)
    for q in subs:
        try:
            q.put_nowait(event)
        except Exception:
            pass


def log(msg):
    line = f"{time.strftime('%H:%M:%S')} [{os.getpid()}] {msg}"
    print(line, file=sys.stderr, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except Exception:
        pass


def sock_path():
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        base = os.path.expanduser("~/.cache/cosmic-fabric")
        os.makedirs(base, exist_ok=True)
    return os.path.join(base, "cosmic-fabric.sock")


def handle(req):
    op = req.get("op")
    if op == "ping":
        return {"ok": True, "serve": FAB.alive()}
    if op == "patterns":
        global _pat_cache
        with _lock:
            if _pat_cache is None:
                _pat_cache = FAB.list_patterns()
        return {"patterns": _pat_cache}
    if op == "models":
        return {"models": FAB.list_models()}
    if op == "status":
        pol = core.load_policy()
        return {"serve": FAB.alive(),
                "loaded": core.loaded_models(pol["ollama"]["url"]),
                "vram": core.gpu_vram(),
                "default_model": pol["default"].get("model"),
                "default_vendor": pol["default"].get("vendor")}
    if op == "run":
        pat = req.get("pattern")
        if not pat:
            return {"error": "missing pattern"}
        pol = core.load_policy()  # re-read live so policy edits take effect
        dmodel, dvendor, extra = core.resolve_model(pat, pol)
        model = req.get("model") or dmodel
        vendor = req.get("vendor") or dvendor
        opts = core.extra_to_options(extra)
        log(f"run pattern={pat} model={model} vendor={vendor} input={len(req.get('input',''))}ch opts={opts}")
        try:
            out = FAB.run(pat, req.get("input", ""), model, vendor, req.get("variables"), opts)
        except Exception as e:
            log(f"run error: {e}")
            return {"error": str(e)}
        pct = core.gpu_placement(model, pol["ollama"]["url"]) if (vendor or "").lower() == "ollama" else None
        log(f"run done: {len(out)}ch placement={pct}")
        return {"output": out, "model": model, "vendor": vendor,
                "placement": pct, "warn_below": pol["ollama"].get("warn_below_gpu", 99)}
    return {"error": f"unknown op {op!r}"}


def stream_run(req, send):
    """`{"op":"run","stream":true}` → {"chunk":...} lines then {"done":...}.

    With `"broadcast":true` the run's events are pushed to all subscribers
    (the panel) as {"event":"start|chunk|done", ...} instead, and the
    requester (the launcher) just gets {"dispatched":true} — this is the
    launcher→panel handoff."""
    pat = req.get("pattern")
    if not pat:
        send({"error": "missing pattern"})
        return
    bcast = bool(req.get("broadcast"))
    if bcast:
        with SUBS_LOCK:
            nsubs = len(SUBS)
        if nsubs == 0:
            # No panel subscribed — don't run into the void; let the caller
            # (launcher) fall back to local delivery.
            send({"dispatched": False, "subscribers": 0})
            return
    pol = core.load_policy()
    dmodel, dvendor, extra = core.resolve_model(pat, pol)
    model = req.get("model") or dmodel
    vendor = req.get("vendor") or dvendor
    opts = core.extra_to_options(extra)
    warn_below = pol["ollama"].get("warn_below_gpu", 99)
    log(f"run-stream pattern={pat} model={model} vendor={vendor} broadcast={bcast}")
    if bcast:
        broadcast({"event": "start", "pattern": pat, "model": model})
        send({"dispatched": True, "subscribers": nsubs})  # quick ack; the panel shows it

    def on_chunk(c):
        if bcast:
            broadcast({"event": "chunk", "text": c})
        else:
            send({"chunk": c})

    try:
        FAB.run(pat, req.get("input", ""), model, vendor, req.get("variables"), opts, on_chunk=on_chunk)
    except Exception as e:
        log(f"run-stream error: {e}")
        (broadcast if bcast else send)({"event": "error", "error": str(e)} if bcast else {"error": str(e)})
        return
    pct = core.gpu_placement(model, pol["ollama"]["url"]) if (vendor or "").lower() == "ollama" else None
    log(f"run-stream done: placement={pct} broadcast={bcast}")
    done = {"model": model, "vendor": vendor, "placement": pct, "warn_below": warn_below}
    if bcast:
        broadcast({"event": "done", **done})
    else:
        send({"done": True, **done})


def run_subscribe(send):
    """Dedicate this connection to receiving broadcast events (the panel)."""
    q = queue.Queue(maxsize=512)
    with SUBS_LOCK:
        SUBS.append(q)
    log(f"subscriber added ({len(SUBS)} total)")
    try:
        send({"subscribed": True})
        while True:
            send(q.get())  # raises when the peer (panel) disconnects
    except Exception:
        pass
    finally:
        with SUBS_LOCK:
            if q in SUBS:
                SUBS.remove(q)
        log("subscriber removed")


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        def send(obj):
            self.wfile.write((json.dumps(obj) + "\n").encode())
            self.wfile.flush()

        for raw in self.rfile:
            raw = raw.strip()
            if not raw:
                continue
            try:
                req = json.loads(raw)
            except Exception:
                send({"error": "bad json"})
                continue
            if req.get("op") == "subscribe":
                run_subscribe(send)
                return  # connection dedicated to pushing broadcasts
            if req.get("op") == "run" and (req.get("stream") or req.get("broadcast")):
                stream_run(req, send)
            else:
                send(handle(req))


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    global FAB
    FAB = core.FabricClient(log=log)
    FAB.ensure_serve()
    path = sock_path()
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    except OSError as e:
        log(f"could not remove stale socket: {e}")
    srv = Server(path, Handler)
    log(f"listening on {path}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
