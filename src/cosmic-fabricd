#!/usr/bin/env python3
"""cosmic-fabricd — the cosmic-fabric backbone.

Owns one fabric deployment: ensures `fabric --serve` is up, holds the policy,
runs patterns over REST, checks GPU placement, and serves a unix-socket JSON API
that thin clients (the launcher now; panel/settings later) call.

Protocol: line-delimited JSON, one request → one response per line (json escapes
newlines, so bodies stay single-line). Ops:
  {"op":"ping"}                                  -> {"ok":true,"serve":bool}
  {"op":"patterns"}                              -> {"patterns":[...]}
  {"op":"run","pattern":P,"input":T,             -> {"output":...,"model":...,
        "model"?:M,"vendor"?:V,"variables"?:{}}        "vendor":...,"placement":pct,"warn_below":n}
                                                    or {"error":"..."}
"""
import json
import os
import queue
import socket
import socketserver
import subprocess
import sys
import threading
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import core  # noqa: E402

LOG = os.path.expanduser("~/.cache/cosmic-fabric/daemon.log")
FAB = None

# Result broker: subscribers (e.g. the panel) register a queue; a run with
# "broadcast":true (e.g. from the launcher) pushes its events to all of them.
SUBS = []
SUBS_LOCK = threading.Lock()

# Panel-confirm registry: a tool-loop thread blocks on `event` waiting for the
# panel's tool_confirm response (separate connection). Keyed by request id so a
# concurrent confirm goes to the right tool call. See doc/design/
# tool-calling-plan.md Axis 2 ("the UI handshake") for the protocol.
_PENDING_CONFIRMS = {}            # id -> {"event": threading.Event, "approved": bool}
_PENDING_LOCK = threading.Lock()
_CONFIRM_TIMEOUT = 60.0           # seconds the daemon will wait for an answer


def _await_confirm(request_id, name=""):
    """Block until the panel responds with a tool_confirm op for `request_id`,
    or the timeout fires. The matching `tool_confirm_required` event was
    already emitted upstream by `core.run_with_tools` via its on_event hook —
    this function does just the wait + dispatch."""
    entry = {"event": threading.Event(), "approved": False}
    with _PENDING_LOCK:
        _PENDING_CONFIRMS[request_id] = entry
    answered = entry["event"].wait(timeout=_CONFIRM_TIMEOUT)
    with _PENDING_LOCK:
        _PENDING_CONFIRMS.pop(request_id, None)
    if not answered:
        log(f"tool_confirm timeout for id={request_id} name={name}")
        return False
    return entry["approved"]


def _confirm_callback_for_stream():
    """The callback `core.run_with_tools(confirm=...)` expects:
    `(call_id, name, args, preview) -> bool`. The streaming `run` path uses
    this so the panel can approve via a side-channel `tool_confirm` op."""
    def confirm(call_id, name, _args, _preview):
        return _await_confirm(call_id, name)
    return confirm


# ---------- woollama inference seam -----------------------------------------
# A plain run can route its inference through the woollama router instead of
# The plain-run path goes through woollama: it renders the pattern on /w1 and
# infers, forwarding fabric's advanced fields (context/strategy/language/search)
# to its own managed fabric backend. Gated by the [woollama] policy block, with
# automatic fallback to fabric (disabled, no live server, or any error — including
# a pattern/context woollama's fabric can't serve). Sessions/tools/image runs are
# handled on their own branches; see doc/integration-plan + the seam plan.

def _woollama_extra(req):
    """The fabric advanced fields woollama's /w1/run forwards to its fabric backend
    (empty for a plain run). Kept out of the run body unless actually set."""
    extra = {k: req[k] for k in ("context", "strategy", "language") if req.get(k)}
    if req.get("search"):
        extra["search"] = True
    return extra


def _woollama_sync(pol, pat, inp, model, vendor, inst, variables, extra=None):
    """Run the plain inference path through woollama. Returns the output text, or
    None to mean 'fall back to fabric' (disabled / no server / error)."""
    if not core.woollama_enabled(pol):
        return None
    wool = core.WoollamaClient(address=(pol.get("woollama") or {}).get("address"), log=log)
    if not wool.alive():
        log("woollama enabled but no server discoverable; falling back to fabric")
        return None
    try:
        wmodel = core.woollama_model(model, vendor)
        opts = core.to_openai_options(inst)
        # A recipe (woollama/<recipe>) owns its prompt, so there's nothing to
        # template — infer it directly on /v1. A plain pattern, though, is
        # rendered AND inferred by woollama on /w1 (it owns the templating now;
        # cosmic-fabric no longer assembles the prompt via fabric).
        is_recipe = (vendor or "").lower() == "woollama"
        if pat and not is_recipe:
            out = wool.run_pattern(pat, inp, variables=variables, model=wmodel,
                                   options=opts, extra=extra)
            log(f"run via woollama /w1 pattern={pat} model={wmodel} → {len(out)}ch")
        else:
            out = wool.chat(wmodel, inp, opts)  # recipe owns its prompt, or no pattern → raw
            log(f"run via woollama chat model={wmodel} recipe={is_recipe} → {len(out)}ch")
        return out
    except Exception as e:
        log(f"woollama path failed ({e}); falling back to fabric")
        return None


def _pattern_names(pol):
    """Pattern names from woollama's `/w1/patterns` — the source of truth when
    woollama is enabled+alive (its managed fabric serves the same library plus any
    recipes) — falling back to fabric's own list when woollama is off/unreachable."""
    if core.woollama_enabled(pol):
        wool = core.WoollamaClient(address=(pol.get("woollama") or {}).get("address"), log=log)
        if wool.alive():
            try:
                return wool.list_patterns()
            except Exception as e:
                log(f"woollama list_patterns failed ({e}); falling back to fabric")
    return FAB.list_patterns()


def _woollama_catalog(pol):
    """woollama's addressable **base models** as {"models": [ids], "vendors":
    {vendor: [model]}} for the model pickers — same shape fabric's catalog had, so
    the panel needs no change. woollama ids are `provider/model` (e.g.
    `ollama/qwen3:14b`); the vendors map splits them on the first `/`. The
    `woollama/<name>` namespace (recipes + the fabric pattern library, addressable
    as models) is excluded — those are patterns, not inference models, and belong in
    the pattern picker, not the model picker. Returns None when woollama is
    off/unreachable so the caller falls back to fabric's catalog. (Cloud providers
    woollama doesn't yet enumerate in /v1/models are absent here — see woollama #3;
    they still route by id, matching the Run-tab picker's existing behavior.)"""
    if not core.woollama_enabled(pol):
        return None
    wool = core.WoollamaClient(address=(pol.get("woollama") or {}).get("address"), log=log)
    if not wool.alive():
        return None
    try:
        ids = wool.list_models()
    except Exception as e:
        log(f"woollama catalog failed ({e}); falling back to fabric")
        return None
    vendors, models = {}, []
    for mid in ids:
        prov, _, rest = mid.partition("/")
        if prov and rest and prov != "woollama":  # skip recipes/patterns-as-models
            vendors.setdefault(prov, []).append(rest)
            models.append(mid)
    return {"models": models, "vendors": vendors}


def broadcast(event):
    with SUBS_LOCK:
        subs = list(SUBS)
    for q in subs:
        try:
            q.put_nowait(event)
        except Exception:
            pass


def notify_user(text, pattern):
    """Clipboard + desktop notification for a completed broadcast run. Lives in
    the daemon (one process) so the alert fires exactly once, regardless of how
    many panel clients are subscribed."""
    try:
        subprocess.run(["wl-copy"], input=text, text=True, timeout=5)
    except Exception as e:
        log(f"wl-copy: {e}")
    preview = text[:200]
    body = f"✓ copied ({len(text)} chars) · open the Fabric panel\n\n{preview}"
    try:
        subprocess.run(["notify-send", f"Fabric: {pattern}", body], timeout=5,
                       stdin=subprocess.DEVNULL)
    except Exception as e:
        log(f"notify-send: {e}")


def log(msg):
    line = f"{time.strftime('%H:%M:%S')} [{os.getpid()}] {msg}"
    print(line, file=sys.stderr, flush=True)
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except Exception:
        pass


def sock_path():
    base = os.environ.get("XDG_RUNTIME_DIR")
    if not base:
        base = os.path.expanduser("~/.cache/cosmic-fabric")
        os.makedirs(base, exist_ok=True)
    return os.path.join(base, "cosmic-fabric.sock")


def handle(req):
    op = req.get("op")
    if op == "ping":
        return {"ok": True, "serve": FAB.alive()}
    if op == "tool_confirm":
        # Side-channel ack from the panel: a tool-loop thread is blocked on
        # the matching event. Look it up, set approved, signal.
        rid = req.get("id")
        approved = bool(req.get("approved"))
        with _PENDING_LOCK:
            entry = _PENDING_CONFIRMS.get(rid)
        if entry is None:
            return {"ok": False, "error": "unknown or expired confirm id"}
        entry["approved"] = approved
        entry["event"].set()
        log(f"tool_confirm id={rid} approved={approved}")
        return {"ok": True}
    if op == "fabric_url":
        # The live fabric REST base URL (loopback). Escape hatch for tools that
        # want raw fabric — most callers should use the ops above instead.
        return {"url": FAB.url}
    if op == "patterns":
        # Computed live (not cached): woollama's /w1 list can change as its managed
        # fabric hot-reloads or comes up after the daemon, and a stale once-filled
        # cache would also diverge from the live `surface` op below.
        return {"patterns": _pattern_names(core.load_policy())}
    if op == "models":
        # The per-pattern model picker, now sourced from woollama (unifying it with
        # the Run-tab `woollama_models` picker); fabric's catalog is the fallback.
        cat = _woollama_catalog(core.load_policy())
        if cat is not None:
            return cat
        return {"models": FAB.list_models(), "vendors": FAB.model_catalog()}
    if op == "woollama_models":
        # The router's addressable models, for the Run-tab per-run model picker.
        pol = core.load_policy()
        wool = core.WoollamaClient(address=(pol.get("woollama") or {}).get("address"), log=log)
        try:
            return {"models": wool.list_models()}
        except Exception as e:
            log(f"woollama_models error: {e}")
            return {"models": [], "error": str(e)}
    if op == "assemble":
        pat = req.get("pattern")
        if not pat:
            return {"error": "missing pattern"}
        pol = core.load_policy()
        inp, variables = req.get("input", ""), req.get("variables")
        # woollama owns templating: render on /w1; fall back to fabric assembly.
        if core.woollama_enabled(pol):
            wool = core.WoollamaClient(address=(pol.get("woollama") or {}).get("address"), log=log)
            if wool.alive():
                try:
                    prompt = wool.render(pat, inp, variables)
                    log(f"assemble via woollama /w1 pattern={pat} → {len(prompt)} chars")
                    return {"prompt": prompt}
                except Exception as e:
                    log(f"woollama render failed ({e}); falling back to fabric")
        try:
            prompt = FAB.assemble_prompt(pat, inp, variables)
        except Exception as e:
            log(f"assemble error: {e}")
            return {"error": str(e)}
        log(f"assemble pattern={pat} → {len(prompt)} chars")
        return {"prompt": prompt}
    if op == "surface":
        pol = core.load_policy()
        return {"active": core.active_patterns(pol, _pattern_names(pol))}
    if op == "fetch":
        url = req.get("url")
        if not url:
            return {"error": "missing url"}
        mode = req.get("mode", "scrape")
        try:
            text = core.fetch_url(url, mode)
        except Exception as e:
            log(f"fetch error: {e}")
            return {"error": str(e)}
        log(f"fetch {mode} {url} -> {len(text)} chars")
        return {"text": text, "chars": len(text)}
    if op == "status":
        pol = core.load_policy()
        dinst = core.resolve("", pol)  # "" ∉ patterns → resolves the default
        return {"serve": FAB.alive(),
                "loaded": core.loaded_models(pol["ollama"]["url"]),
                "vram": core.gpu_vram(),
                "default_model": dinst.get("model"),
                "default_vendor": dinst.get("vendor"),
                "woollama": core.woollama_status(pol)}
    if op == "run":
        pat = req.get("pattern")
        image = req.get("image")
        if not pat and not image:
            return {"error": "missing pattern"}  # a text run needs a pattern; image runs don't
        pol = core.load_policy()  # re-read live so policy edits take effect
        inp = req.get("input", "")

        # Tool-using pattern? Sidecar meta.toml opt-in (Axis 1 + 3 of the plan).
        # Bypass fabric entirely for the tool path; daemon owns the loop.
        meta = core.pattern_meta(pat) if pat else {}
        if not image and meta.get("tool_use"):
            inst = core.resolve(pat, pol)
            model = req.get("model") or inst["model"]
            vendor = req.get("vendor") or inst["vendor"]
            tools = core._filter_tools(core.builtin_tools(), meta.get("tools"))
            max_turns = int(meta.get("tool_max_turns") or core.DEFAULT_TOOL_MAX_TURNS)
            log(f"run-tools pattern={pat} model={model} vendor={vendor} "
                f"tools={list(tools)} max_turns={max_turns}")
            trace = []
            try:
                out = core.run_with_tools(
                    pat, inp, model, vendor,
                    policy=pol, tools=tools,
                    on_chunk=None, on_event=trace.append,
                    max_turns=max_turns, variables=req.get("variables"),
                    ollama_url=pol["ollama"]["url"], log=log)
            except Exception as e:
                log(f"run-tools error: {e}")
                return {"error": str(e)}
            pct = core.gpu_placement(model, pol["ollama"]["url"]) \
                if (vendor or "").lower() == "ollama" else None
            log(f"run-tools done: {len(out)}ch trace={len(trace)} placement={pct}")
            return {"output": out, "model": model, "vendor": vendor,
                    "placement": pct, "trace": trace,
                    "warn_below": pol["ollama"].get("warn_below_gpu", 99)}

        # An image run needs a vision model — the capability rule swaps one in.
        inst = core.resolve(pat, pol, need_capability="vision" if image else None)
        model = req.get("model") or inst["model"]
        vendor = req.get("vendor") or inst["vendor"]
        if image:
            log(f"run image={image} pattern={pat} model={model} vendor={vendor} (vision rule)")
            try:
                out = FAB.run_image(image, inp, model, vendor, pattern=pat or None)
            except Exception as e:
                log(f"run-image error: {e}")
                return {"error": str(e)}
            pct = core.gpu_placement(model, pol["ollama"]["url"]) if (vendor or "").lower() == "ollama" else None
            return {"output": out, "model": model, "vendor": vendor, "placement": pct,
                    "warn_below": pol["ollama"].get("warn_below_gpu", 99), "capability": "vision"}
        opts = core.inst_to_options(inst)
        is_ollama = (vendor or "").lower() == "ollama"
        mctx = inst.get("ctx") or (core.pick_ctx(inp) if is_ollama else None)
        # woollama inference seam: plain runs render+infer on woollama's /w1, with
        # fabric's advanced fields forwarded to woollama's fabric backend. Any
        # failure (disabled/down/unservable) returns None → fabric fallback below.
        wout = _woollama_sync(pol, pat, inp, model, vendor, inst,
                              req.get("variables"), _woollama_extra(req))
        if wout is not None:
            pct = core.gpu_placement(model, pol["ollama"]["url"]) if is_ollama else None
            return {"output": wout, "model": model, "vendor": vendor, "backend": "woollama",
                    "placement": pct, "warn_below": pol["ollama"].get("warn_below_gpu", 99)}
        log(f"run pattern={pat} model={model} vendor={vendor} input={len(inp)}ch ctx={mctx} opts={opts}")
        try:
            out = FAB.run(pat, inp, model, vendor, req.get("variables"), opts, model_ctx=mctx,
                          context=req.get("context"), strategy=req.get("strategy"),
                          language=req.get("language"), search=bool(req.get("search")))
        except Exception as e:
            log(f"run error: {e}")
            return {"error": str(e)}
        pct = core.gpu_placement(model, pol["ollama"]["url"]) if (vendor or "").lower() == "ollama" else None
        log(f"run done: {len(out)}ch placement={pct}")
        return {"output": out, "model": model, "vendor": vendor, "backend": "fabric",
                "placement": pct, "warn_below": pol["ollama"].get("warn_below_gpu", 99)}
    return {"error": f"unknown op {op!r}"}


def stream_run(req, send):
    """`{"op":"run","stream":true}` → {"chunk":...} lines then {"done":...}.

    With `"broadcast":true` the run's events are pushed to all subscribers
    (the panel) as {"event":"start|chunk|done", ...} instead, and the
    requester (the launcher) just gets {"dispatched":true} — this is the
    launcher→panel handoff."""
    pat = req.get("pattern")
    session = req.get("session")
    if not pat and not session:
        send({"error": "missing pattern"})  # a bare run needs a pattern; chat needs a session
        return
    bcast = bool(req.get("broadcast"))
    if bcast:
        with SUBS_LOCK:
            nsubs = len(SUBS)
        if nsubs == 0:
            # No panel subscribed — don't run into the void; let the caller
            # (launcher) fall back to local delivery.
            send({"dispatched": False, "subscribers": 0})
            return
    if session and not pat:
        pat = "raw_query"  # fabric's universal relay — chat without a transforming pattern
    pol = core.load_policy()
    inst = core.resolve(pat or "", pol)  # chat → the default instantiation
    model = req.get("model") or inst["model"]
    vendor = req.get("vendor") or inst["vendor"]
    opts = core.inst_to_options(inst)
    warn_below = pol["ollama"].get("warn_below_gpu", 99)
    log(f"run-stream pattern={pat} session={session} model={model} vendor={vendor} broadcast={bcast}")
    if bcast:
        broadcast({"event": "start", "pattern": pat, "model": model})
        send({"dispatched": True, "subscribers": nsubs})  # quick ack; the panel shows it

    def on_chunk(c):
        if bcast:
            broadcast({"event": "chunk", "text": c})
        else:
            send({"chunk": c})

    inp = req.get("input", "")

    # Stateful chat via woollama's conversations API — for claude-code /
    # claude-agent backends (claude-resume / managed-agents own the history).
    # Non-streaming (woollama defers stateful streaming): one request, full reply.
    if (session and core.woollama_enabled(pol)
            and (vendor or "").lower() in ("claude-code", "claude-agent")):
        wool = core.WoollamaClient(address=(pol.get("woollama") or {}).get("address"), log=log)
        wmodel = core.woollama_model(model, vendor)
        # Attach-by-key: drive the conversation by our own (namespaced) session
        # name and let woollama own the durable key→conv map — it survives daemon
        # restarts, and we no longer hold the conversation id ourselves. The
        # `cosmic-fabric:` prefix isolates our keys in woollama's GLOBAL keyspace
        # (other clients — lackpy, a second panel — share that map).
        key = f"cosmic-fabric:{session}"
        log(f"run-stream stateful woollama model={wmodel} session={session} (attach-by-key)")
        try:
            text, _ = wool.respond(wmodel, inp, key=key)  # we no longer keep the conv id
        except Exception as e:
            log(f"woollama respond error: {e}")
            (broadcast if bcast else send)(
                {"event": "error", "error": str(e)} if bcast else {"error": str(e)})
            return
        on_chunk(text)  # deliver the full reply as a single chunk
        done = {"model": model, "vendor": vendor, "placement": None,
                "warn_below": warn_below, "backend": "woollama"}
        if bcast:
            broadcast({"event": "done", **done})
            notify_user(text, pat)
        else:
            send({"done": True, **done})
        return

    # Tool-using pattern? Same branch as the sync `run` op — daemon owns the
    # loop, bypasses fabric. Each tool event becomes its own SSE-style line.
    meta = core.pattern_meta(pat) if pat else {}
    if meta.get("tool_use") and not session:
        # (Session + tools is a future combination — skip for Phase 1.)
        tools = core._filter_tools(core.builtin_tools(), meta.get("tools"))
        max_turns = int(meta.get("tool_max_turns") or core.DEFAULT_TOOL_MAX_TURNS)
        def on_event(ev):
            if bcast:
                broadcast({"event": "tool", **ev})
            else:
                send({"tool": ev})
        log(f"run-stream-tools pattern={pat} model={model} vendor={vendor} "
            f"tools={list(tools)} max_turns={max_turns}")
        try:
            out = core.run_with_tools(
                pat, inp, model, vendor,
                policy=pol, tools=tools,
                on_chunk=on_chunk, on_event=on_event,
                confirm=_confirm_callback_for_stream(),
                max_turns=max_turns, variables=req.get("variables"),
                ollama_url=pol["ollama"]["url"], log=log)
        except Exception as e:
            log(f"run-stream-tools error: {e}")
            (broadcast if bcast else send)(
                {"event": "error", "error": str(e)} if bcast else {"error": str(e)})
            return
        pct = core.gpu_placement(model, pol["ollama"]["url"]) \
            if (vendor or "").lower() == "ollama" else None
        log(f"run-stream-tools done: placement={pct}")
        done = {"model": model, "vendor": vendor, "placement": pct, "warn_below": warn_below}
        if bcast:
            broadcast({"event": "done", **done})
            notify_user(out, pat)
        else:
            send({"done": True, **done})
        return

    # woollama inference seam: plain, session-less streaming runs render+stream on
    # woollama's /w1 (it owns templating). The live-server pre-check AND a failure
    # before any chunk is emitted both fall back to fabric; only a failure AFTER
    # chunks have streamed surfaces as an error (a partial stream can't be un-sent).
    backend = "fabric"
    out = None
    wool = (core.WoollamaClient(address=(pol.get("woollama") or {}).get("address"), log=log)
            if (core.woollama_enabled(pol) and not session)
            else None)
    if wool is not None and wool.alive():
        sent = 0

        def on_wchunk(c):
            nonlocal sent
            sent += 1
            on_chunk(c)
        try:
            wmodel = core.woollama_model(model, vendor)
            wopts = core.to_openai_options(inst)  # NB: distinct from fabric's `opts` below
            # A recipe owns its prompt → stream it raw on /v1. A plain pattern is
            # rendered + streamed by woollama on /w1 (no fabric prompt assembly).
            is_recipe = (vendor or "").lower() == "woollama"
            if pat and not is_recipe:
                out = wool.run_pattern_stream(pat, inp, on_chunk=on_wchunk,
                                              variables=req.get("variables"),
                                              model=wmodel, options=wopts,
                                              extra=_woollama_extra(req))
                log(f"run-stream via woollama /w1 pattern={pat} model={wmodel} → {len(out)}ch")
            else:
                out = wool.chat_stream(wmodel, inp, on_chunk=on_wchunk, options=wopts)
                log(f"run-stream via woollama chat model={wmodel} recipe={is_recipe} → {len(out)}ch")
            backend = "woollama"
        except Exception as e:
            if sent:  # a partial stream already went out — can't safely retry on fabric
                log(f"run-stream woollama error after {sent} chunks: {e}")
                (broadcast if bcast else send)(
                    {"event": "error", "error": str(e)} if bcast else {"error": str(e)})
                return
            log(f"woollama stream failed before any chunk ({e}); falling back to fabric")
            out = None  # fall through to the fabric path below
    elif wool is not None:
        log("woollama enabled but no server discoverable; falling back to fabric")

    if out is None:
        # Local/ollama stateful chat through woollama (conv-7 store-backed): drive
        # the conversation by our own session key (attach-by-key) when woollama has
        # a conversation store wired. Degrades cleanly — if woollama is down or has
        # no store for ollama (HTTP 501), we fall through to fabric's server-side
        # session below, so Local chat keeps working without a store configured.
        if session and core.woollama_enabled(pol) and (vendor or "").lower() == "ollama":
            wsess = core.WoollamaClient(address=(pol.get("woollama") or {}).get("address"), log=log)
            if wsess.alive():
                try:
                    text, _ = wsess.respond(core.woollama_model(model, vendor), inp,
                                            key=f"cosmic-fabric:{session}")
                    on_chunk(text)  # full reply as one chunk (woollama defers stateful streaming)
                    out, backend = text, "woollama"
                    log(f"run-stream ollama session via woollama (attach-by-key) → {len(text)}ch")
                except Exception as e:
                    log(f"woollama ollama-session unavailable ({e}); falling back to fabric session")
        if out is None:
            mctx = inst.get("ctx") or (core.pick_ctx(inp) if (vendor or "").lower() == "ollama" else None)
            try:
                out = FAB.run(pat, inp, model, vendor, req.get("variables"), opts,
                              on_chunk=on_chunk, model_ctx=mctx, session=session,
                              context=req.get("context"), strategy=req.get("strategy"),
                              language=req.get("language"), search=bool(req.get("search")))
            except Exception as e:
                log(f"run-stream error: {e}")
                (broadcast if bcast else send)({"event": "error", "error": str(e)} if bcast else {"error": str(e)})
                return
    pct = core.gpu_placement(model, pol["ollama"]["url"]) if (vendor or "").lower() == "ollama" else None
    log(f"run-stream done: placement={pct} broadcast={bcast} backend={backend}")
    done = {"model": model, "vendor": vendor, "placement": pct, "warn_below": warn_below,
            "backend": backend}
    if bcast:
        broadcast({"event": "done", **done})
        notify_user(out, pat)  # one alert, from the daemon (not per-panel)
    else:
        send({"done": True, **done})


def run_subscribe(send, rfile):
    """Dedicate this connection to receiving broadcast events (the panel).
    A watcher thread reads the (otherwise-silent) socket to detect disconnect
    promptly, so stale subscribers don't linger until the next failed send."""
    q = queue.Queue(maxsize=512)
    stop = object()
    with SUBS_LOCK:
        SUBS.append(q)
    log(f"subscriber added ({len(SUBS)} total)")

    def watch_disconnect():
        try:
            while rfile.read(1):  # subscriber sends nothing; read blocks until EOF
                pass
        except Exception:
            pass
        q.put(stop)
    threading.Thread(target=watch_disconnect, daemon=True).start()

    try:
        send({"subscribed": True})
        while True:
            ev = q.get()
            if ev is stop:
                break
            send(ev)
    except Exception:
        pass
    finally:
        with SUBS_LOCK:
            if q in SUBS:
                SUBS.remove(q)
        log(f"subscriber removed ({len(SUBS)} left)")


class Handler(socketserver.StreamRequestHandler):
    def handle(self):
        def send(obj):
            self.wfile.write((json.dumps(obj) + "\n").encode())
            self.wfile.flush()

        for raw in self.rfile:
            raw = raw.strip()
            if not raw:
                continue
            try:
                req = json.loads(raw)
            except Exception:
                send({"error": "bad json"})
                continue
            if req.get("op") == "subscribe":
                run_subscribe(send, self.rfile)
                return  # connection dedicated to pushing broadcasts
            if req.get("op") == "run" and (req.get("stream") or req.get("broadcast")):
                stream_run(req, send)
            else:
                send(handle(req))


class Server(socketserver.ThreadingUnixStreamServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    global FAB
    path = sock_path()
    # Don't steal the socket from a live daemon — that orphans it (and its
    # subscribers). If one already answers, exit; only take over a stale socket.
    if os.path.exists(path):
        try:
            t = socket.socket(socket.AF_UNIX)
            t.settimeout(1)
            t.connect(path)
            t.sendall(b'{"op":"ping"}\n')
            t.recv(64)
            t.close()
            log("another cosmic-fabricd is already listening; exiting")
            return
        except OSError:
            pass  # stale socket, no live daemon → safe to take over
    FAB = core.FabricClient(log=log)
    FAB.ensure_serve()
    # Own a woollama instance too (discover-first: attaches to a running
    # woollama.service, else spawns a keyless woollamad). Gated on [woollama].
    _pol = core.load_policy()
    if core.woollama_enabled(_pol):
        _wc = _pol.get("woollama") or {}
        core.WoollamaClient(address=_wc.get("address"), log=log).ensure_serve(bin=_wc.get("bin"))
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    except OSError as e:
        log(f"could not remove stale socket: {e}")
    srv = Server(path, Handler)
    log(f"listening on {path}")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
